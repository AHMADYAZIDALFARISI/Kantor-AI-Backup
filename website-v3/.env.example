# Contoh konfigurasi server untuk fungsi /api (Vercel → Settings → Environment Variables).
# JANGAN mengisi nilai asli di file ini. Semua nilai diisi di dashboard Vercel.

# Jalur 1 (utama): proxy ke kantor-bridge lewat tunnel HTTPS.
BRIDGE_URL=
BRIDGE_TOKEN=

# Jalur 2 (cadangan): Gemini langsung dari fungsi serverless.
GEMINI_API_KEY=
# Model yang dicoba berurutan (koma). Default: gemini-3.8-flash,gemini-3.1-pro-preview
GEMINI_MODEL=

# Model untuk jalur bridge (opsional; server yang memilih, bukan klien).
CHAT_MODEL=
# Batas chat per IP per jam (default 20).
CHAT_LIMIT_PER_HOUR=
# Origin yang diizinkan memanggil /api/chat (contoh: https://kantor-kcsh.vercel.app).
ALLOWED_ORIGIN=
